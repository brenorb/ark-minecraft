{
  "name": "ark-minecraft",
  "version": "0.1.0",
  "description": "Generate Ark-compatible QR map files for Minecraft.",
  "type": "module",
  "bin": {
    "ark-minecraft": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
